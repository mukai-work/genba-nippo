<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- OpenAPI ドキュメントに XML コメント（///）を出すため -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenAPI ドキュメントは .NET 標準の生成機能で作り、画面表示だけ Swagger UI を使う -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GenbaNippo.Domain\GenbaNippo.Domain.csproj" />
    <ProjectReference Include="..\GenbaNippo.Infrastructure\GenbaNippo.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 結合テストから Program を参照できるようにする -->
    <InternalsVisibleTo Include="GenbaNippo.Api.Tests" />
  </ItemGroup>

</Project>
